{
  "name": "@brim-software/email-kit",
  "version": "0.2.0",
  "description": "Shared server email client for SMTP, local capture, and memory tests",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./templates": {
      "types": "./dist/templates.d.ts",
      "import": "./dist/templates.js"
    }
  },
  "files": [
    "dist",
    "examples",
    "README.md",
    "LICENSE",
    "PUBLISHING.md",
    "TEMPLATES.md",
    "docs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint . --max-warnings=0 && prettier . --check",
    "lint:fix": "eslint . --fix && prettier --write --list-different .",
    "prepack": "npm run build",
    "preview:templates": "npm run build && node examples/template-previews.mjs",
    "test": "npm run test:unit && npm run test:integration && npm run test:e2e && npm run test:package",
    "test:coverage": "vitest run --project unit --project integration --coverage",
    "test:e2e": "npm run build && playwright test",
    "test:integration": "vitest run --project integration",
    "test:package": "node tests/packed-artifact.mjs",
    "test:unit": "vitest run --project unit"
  },
  "dependencies": {
    "nodemailer": "10.0.10"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "8.0.1",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "prettier": "3.3.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.71.0",
    "vitest": "4.1.11"
  },
  "license": "MIT",
  "author": "bcronce17",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brim-software/email-kit.git"
  },
  "bugs": {
    "url": "https://github.com/brim-software/email-kit/issues"
  },
  "homepage": "https://github.com/brim-software/email-kit#readme",
  "keywords": [
    "email",
    "smtp",
    "mailpit",
    "nodemailer",
    "typescript"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  }
}

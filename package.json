{
  "name": "@brim-software/email-kit",
  "version": "0.2.0",
  "description": "Shared server email client for SMTP, local capture, and memory tests",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./templates": {
      "types": "./dist/templates.d.ts",
      "import": "./dist/templates.js"
    }
  },
  "files": [
    "dist",
    "examples",
    "README.md",
    "LICENSE",
    "PUBLISHING.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test tests/*.test.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build",
    "test:package": "node tests/packed-artifact.mjs"
  },
  "dependencies": {
    "nodemailer": "10.0.10"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/nodemailer": "8.0.1",
    "typescript": "^5.9.3"
  },
  "license": "MIT",
  "author": "bcronce17",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brim-software/email-kit.git"
  },
  "bugs": {
    "url": "https://github.com/brim-software/email-kit/issues"
  },
  "homepage": "https://github.com/brim-software/email-kit#readme",
  "keywords": [
    "email",
    "smtp",
    "mailpit",
    "nodemailer",
    "typescript"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  }
}

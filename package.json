{
  "name": "@bcronce/app-email",
  "version": "0.1.0",
  "description": "Shared server email client for SMTP, local capture, and memory tests",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test tests/*.test.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build",
    "test:package": "node tests/packed-artifact.mjs"
  },
  "dependencies": {
    "nodemailer": "10.0.10"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/nodemailer": "8.0.1",
    "typescript": "^5.9.3"
  },
  "license": "MIT",
  "author": "bcronce17",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bcronce17/app-email.git"
  },
  "bugs": {
    "url": "https://github.com/bcronce17/app-email/issues"
  },
  "homepage": "https://github.com/bcronce17/app-email#readme",
  "keywords": [
    "email",
    "smtp",
    "mailpit",
    "nodemailer",
    "typescript"
  ]
}
